# Copy to server/.env (never commit real secrets)
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SAME_SITE=strict
MONGODB_URI=mongodb://127.0.0.1:27017/pizza_delivery
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1d
APP_BASE_URL=http://localhost:4000
CLIENT_BASE_URL=http://localhost:5173
ADMIN_EMAIL=
ADMIN_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
ADMIN_ALERT_EMAIL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
LOW_STOCK_SCAN_CRON=*/15 * * * *
LOW_STOCK_ALERT_COOLDOWN_HOURS=6
