# Copy to server/.env (never commit real secrets)
NODE_ENV=development
PORT=4000
# In production use exact HTTPS origins only; comma-separate multiple origins, without paths or a trailing slash.
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SAME_SITE=strict
MONGODB_URI=mongodb://127.0.0.1:27017/pizza_delivery
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1d
# Base URLs are origins (no paths); trailing slashes are normalized.
APP_BASE_URL=http://localhost:4000
CLIENT_BASE_URL=http://localhost:5173
# Set both in deployment to bootstrap an initial admin; the password is hashed and never reset on restart.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Preferred for Render Free: HTTPS API, requires a verified sender domain and a Resend API key.
RESEND_API_KEY=
# SMTP remains supported for local/other hosts. Render Free blocks outbound SMTP ports 25/465/587.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Example: Pizza House <orders@your-verified-domain.example>
MAIL_FROM=
# Optional: set true to require email verification before sign-in. Default false keeps signup usable without an outbound email provider.
REQUIRE_EMAIL_VERIFICATION=false
ADMIN_ALERT_EMAIL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set this separately in the Razorpay Dashboard webhook configuration.
RAZORPAY_WEBHOOK_SECRET=
LOW_STOCK_SCAN_CRON=*/15 * * * *
LOW_STOCK_ALERT_COOLDOWN_HOURS=6
